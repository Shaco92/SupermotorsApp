<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/content_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado de la pantalla -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_video"
                app:tint="@color/menu_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/video_title"
                android:textColor="@color/menu_background"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Badge de la moto actual -->
        <TextView
            android:id="@+id/txt_video_bike_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HONDA CBR600RR · Deportiva"
            android:textColor="@color/menu_background"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_badge_accent"
            android:layout_marginBottom="14dp" />

        <!-- Tarjeta del Reproductor de Video -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A">

                <!-- Contenedor del Video / WebView -->
                <FrameLayout
                    android:id="@+id/video_frame_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <android.webkit.WebView
                        android:id="@+id/web_video_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Portada interactiva del video -->
                    <ImageView
                        android:id="@+id/img_video_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_placeholder" />

                    <!-- Overlay oscuro para contraste -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66000000" />

                    <!-- Badge de Duración -->
                    <TextView
                        android:id="@+id/txt_video_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:background="#CC000000"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="04:30 min"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Botón de Play Central -->
                    <LinearLayout
                        android:id="@+id/btn_play_video"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#CCB91C1C"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="@color/white"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <!-- Etiqueta 4K 60FPS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="10dp"
                        android:background="#99000000"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="4K UHD · 60 FPS"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Barra de controles / descripción del video -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txt_video_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Test Drive en Circuito &amp; Sonido a Fondo"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grabación oficial con telemetría en tiempo real, micrófonos de escape binaurales y cámaras on-board de alta resolución."
                        android:textColor="#94A3B8"
                        android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Indicadores de Telemetría -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_chip_unselected"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏁 0 - 100"
                    android:textSize="11sp"
                    android:textColor="#666666"/>
                <TextView
                    android:id="@+id/txt_accel_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~2.9 seg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/content_text"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_chip_unselected"
                android:padding="8dp"
                android:layout_marginHorizontal="2dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Potencia"
                    android:textSize="11sp"
                    android:textColor="#666666"/>
                <TextView
                    android:id="@+id/txt_power_telemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200+ CV"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/button_red"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_chip_unselected"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 Vel. Máx"
                    android:textSize="11sp"
                    android:textColor="#666666"/>
                <TextView
                    android:id="@+id/txt_speed_telemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300 km/h"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/price_color"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botones de Acción de Video -->
        <Button
            android:id="@+id/btn_open_external_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️ Reproducir en YouTube / Navegador"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:backgroundTint="@color/button_red"
            android:background="@drawable/bg_button_red"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_share_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Compartir Video con Amigos"
            android:textColor="@color/content_text"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="@drawable/bg_chip_unselected"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
